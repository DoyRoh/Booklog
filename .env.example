# Supabase 프로젝트 설정 (Settings → API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 카카오 개발자 사이트 → 내 애플리케이션 → 앱 키 → REST API 키
# NEXT_PUBLIC_ 접두사가 없어서 브라우저로 노출되지 않음 (서버에서만 사용)
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# 국립어린이청소년도서관 사서추천도서 Open API (data.go.kr 15104976 → KCISA 발급 인증키)
NLCY_SERVICE_KEY=your-kcisa-service-key
# 아래 계정으로 앱에 미리 회원가입해두고(비밀번호는 여기 값과 동일하게),
# supabase/seed/nlcy_curator.sql로 role=curator + 그룹/추천도서 목록을 세팅해야
# 동기화가 동작함 (자세한 내용은 README 참고)
NLCY_CURATOR_EMAIL=nlcy-curator@example.com
NLCY_CURATOR_PASSWORD=set-a-strong-password

# Vercel Cron이 /api/cron/nlcy-sync를 매일 부를 때 쓰는 비밀값 (임의의 긴 문자열)
CRON_SECRET=set-a-random-secret
