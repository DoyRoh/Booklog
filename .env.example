# Supabase 프로젝트 설정 (Settings → API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 카카오 개발자 사이트 → 내 애플리케이션 → 앱 키 → REST API 키
# NEXT_PUBLIC_ 접두사가 없어서 브라우저로 노출되지 않음 (서버에서만 사용)
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# 국립어린이청소년도서관 사서추천도서 매달 자동 가져오기 (/api/cron/nlcy-sync, 매달 3일 03:00 KST)
# 크론이 이 계정(supabase/seed/nlcy_keeper.sql로 만든 숲지기)으로 로그인해 다섯 그룹을 채운다.
NLCY_CURATOR_PASSWORD=byul890808+nlcy-계정의-비밀번호
# NLCY_CURATOR_EMAIL=byul890808+nlcy@gmail.com   (기본값, 바꿀 때만)

# Vercel Cron이 크론 경로를 부를 때 쓰는 비밀값 (임의의 긴 문자열)
CRON_SECRET=set-a-random-secret

# (선택) 자동 가져오기 결과 메일 — 새 책이 들어왔거나 실패한 달에만 운영자에게 보냄
# RESEND_API_KEY=re_...
